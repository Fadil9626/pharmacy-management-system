# Remedy — backend environment
# Copy to .env and fill in real values. Never commit the real .env.

# API port
PORT=5190

# PostgreSQL connection (see docker-compose.yml for local defaults)
DATABASE_URL=postgresql://pharmacy_user:pharmacy_pass@127.0.0.1:5437/pharmacy_db

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# Shared key the Control Center uses to manage this instance (modules, plans).
# Must match the admin_api_key set on the subscriber in the Control Center.
ADMIN_API_KEY=change-me-to-a-random-admin-key

# ── Software updates ────────────────────────────────────────────────────────
# Where this install asks what version it should be running.
CONTROL_CENTER_URL=https://mtdslms.com/vendor

# The public half of the release signing keypair. Public by nature — it only
# verifies signatures, it cannot make them. An update whose signature does not
# check against this is refused, so this is the install's trust anchor and does
# NOT belong in the database where an admin could edit it.
UPDATE_ED25519_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_YOUR_PUBLIC_KEY\n-----END PUBLIC KEY-----"

# Repository pinning. A manifest naming any other repository is refused even
# with a valid signature, so a stolen signing key is not enough on its own.
UPDATE_REPO=https://github.com/Fadil9626/pharmacy-management-system.git

# Where install requests are left for the root-owned applier. The default is
# already product-specific; set it only if you moved the spool, and then it must
# match the applier's own spoolDir.
# UPDATER_SPOOL_DIR=/var/lib/banoyah-updater-remedy

# Password for the first-boot owner account. If unset, production generates a
# random one and prints it once in the log on first boot.
# SEED_ADMIN_PASSWORD=

# Comma-separated origins allowed to call this API cross-origin. Not needed when
# the API serves the frontend itself (the default deployment).
# CORS_ORIGINS=https://pharmacy.example.com

# Set when Remedy runs behind a reverse proxy (nginx etc.), e.g. TRUST_PROXY=loopback.
# Leave unset when browsers connect to Remedy directly.
# TRUST_PROXY=loopback

# Public address of this install, used in password-reset links (e.g. https://pharmacy.example.com).
# APP_URL=
